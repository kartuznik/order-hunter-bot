# ==========================================
# TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=PLACEHOLDER_TOKEN
NOTIFY_CHAT_IDS=123456789

# ==========================================
# SOURCES
# ==========================================
ENABLE_KWORK_IMAP=true
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=alerts@example.com
IMAP_APP_PASSWORD=app_password_here
IMAP_FOLDER=INBOX
KWORK_EMAIL_FROM=mail@kwork.ru
KWORK_EMAIL_SUBJECT_HINT=проект

ENABLE_FL=true
FL_RSS_URL=https://www.fl.ru/rss/all.xml
ENABLE_KWORK=false
KWORK_PROJECTS_URL=https://kwork.ru/projects
# Ручной токен мобильного API. signIn с VPS не вызывать: датацентровый IP получает капчу.
# Обновлять с домашней машины примерно раз в 30 дней. EXPIRES — unix-секунды.
KWORK_TOKEN=
KWORK_TOKEN_EXPIRES=

# ==========================================
# FILTER
# ==========================================
CORE_KEYWORDS=bot,бот,telegram,телеграм,tg
SECONDARY_KEYWORDS=python,ai,ии,gpt,автоматизация,парсер,скрипт,магазин,оплата,корзина,анкета,заявка,опрос,рассылка
NEGATIVE_KEYWORDS=дизайн,логотип,баннер,иллюстрац,презентац,3d,3д,архитектур,инженер,смет,чертеж,овик,вк,вышивк,перевод,копирайт,рерайт,smm,таргет,seo,контекст,авито,фотограф,музык,диктор,тендер,android,андроид,ios,мобильн,сайт,лендинг

# ==========================================
# RUNTIME
# ==========================================
POLL_INTERVAL_SECONDS=180
DB_PATH=data/order_hunter.db
